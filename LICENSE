script.js

const produtos = [
  {id:'s01',nome:'Sedução em 7 Passos',cat:'sedução',img:'https://picsum.photos/200/300?random=1'},
  {id:'c01',nome:'Bitcoin de 0 a 100',cat:'cripto',img:'https://picsum.photos/200/300?random=2'},
  {id:'f01',nome:'Keto 14 Dias',cat:'fitness',img:'https://picsum.photos/200/300?random=3'},
  {id:'m01',nome:'Magia com Cartas',cat:'magia',img:'https://picsum.photos/200/300?random=4'},
  {id:'a01',nome:'Back Lay Sniper',cat:'apostas',img:'https://picsum.photos/200/300?random=5'},
  // adicione mais objetos aqui
];

const grid = document.getElementById('grid');
produtos.forEach(p=>{
  grid.innerHTML += `
    <div class="card">
      <img src="${p.img}" alt="${p.nome}">
      <h3>${p.nome}</h3>
      <button class="btn" onclick="comprar('${p.id}')">R$ 9,90</button>
    </div>`;
});

function comprar(id){ window.open(`https://pagamento.com/pix/${id}`, '_blank') }
function abrirPagamento(){ window.open('https://pagamento.com/pix/bundle','_blank') }













































